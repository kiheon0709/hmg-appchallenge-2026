<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- Pleos Vehicle 조회 (개발·시험은 선언만으로 사용 가능, 운영사무국 답변 11-06) -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />    <!-- 전조등·상향등·안개등·방향지시등 -->
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />   <!-- 성에 제거·에어컨·내기순환 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />     <!-- 브레이크 페달·조향각 -->
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />   <!-- 와이퍼·창문 -->
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />    <!-- 경고등(Telltale) -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />     <!-- 착좌 -->
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />      <!-- 차종(이 차 면허) -->
    <!-- Pleos Vehicle 제어: 정차 중 앰비언트 조명 연출 -->
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_LIGHTS" />
    <!-- 실측용: 공조·창문 set이 P단·D단에서 되는지 (앱 기능에서는 쓰지 않음, 실측 뒤 정리) -->
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_WINDOWS" />
    <!-- NaviHelper: 남은 시간·도착·휴게소 경유지 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <!-- 음성: Pleos TTS·STT (ON_DEVICE) -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 위치: 일몰 시각, 속도 추정 (dangerous, 런타임 요청) -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <!-- 기어·주차 브레이크·차속: 공개 Pleos SDK에 없어 AAOS 표준 Car API로 읽는다 -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <!-- AI 교관(LLM) 텍스트 요청 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 주행 중 코치: 앱이 뒤에 있어도 말한다 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:resizeableActivity="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- 방향 고정 없음: 가로·세로·창 크기 변경을 Compose가 다시 그린다(재생성 없이 상태 유지) -->
        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode">
            <!-- 주행 중 실행 허용(DO). 주행 중에는 코치 화면만 보인다 -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".app.CoachService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
